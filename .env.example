# Credentials for the benchmark harness only.
# The library itself makes no network calls and needs none of these.
#
#   cp .env.example .env
#
# `npm test` is offline and needs nothing here. Only `bench/` and
# `docs/generate-examples.ts` read these.

# Anthropic — required for: the Anthropic benchmark arm, the live integration
# tests (npm run test:live), and the real token counts in
# docs/generate-examples.ts. This is the one worth setting first.
# Format: sk-ant-...   https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — the gpt-5.6-sol arm. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google AI Studio — the gemini-3.1-pro-preview arm.
# Must be an AI Studio key (starts `AIza`), NOT a Google Cloud / Vertex
# credential — those are rejected by the Generative Language API with a 401.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# xAI — the grok-4.5 arm. https://console.x.ai
XAI_API_KEY=
